# Plantilla de variables de entorno — copiar a .env.local y completar.
# NO incluir secrets reales en este archivo: es solo documentación.

# Base de datos (Neon PostgreSQL)
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# URL base
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_URL=https://motosfernandez.com.ar

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend (emails)
RESEND_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# Admin inicial (seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Meta Graph API (publicar catálogo en FB/IG Business)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_BASE=

# Meta Pixel + Conversions API (campañas de Meta Ads)
# Si tenés pixel viejo y nuevo, podés setear los dos: fbq inicializa ambos.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# content del meta tag de verificacion de dominio (Business Manager)
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
